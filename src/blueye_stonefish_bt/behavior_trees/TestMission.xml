<?xml version="1.0" encoding="UTF-8"?>
<!-- Full mission test with takeover guard.
     takeover_mode:=closed_loop (default). If the Bayesian Network urgency >= threshold:
       1. Drone holds position (HoldPosition: docking stopped, waypoint controller station-keeps)
       2. One operator popup appears in the HUD (/blueye/takeover_request/pending)
       3a. ACCEPT  → joystick control; hand back is possible once urgency < threshold, and the
                     mission resumes at the interrupted step (completed waypoints are skipped)
       3b. REJECT or closing the popup → emergency Transit_2 + Docking sequence
     takeover_mode:=shadow: crossings are only logged; the mission never stops.

     Mission states on /mission_state:
       1 = UnDocking
       2 = Transit
       3 = Pipeline Inspection
       4 = Homing
       5 = Docking
       6 = Takeover (station keeping / joystick) -->
<root BTCPP_format="4" main_tree_to_execute="TestMission">
  <BehaviorTree ID="TestMission">
    <Fallback name="mission_with_takeover_guard">

      <!-- ── NORMAL MISSION (interrupted if takeover is requested) ──────── -->
      <ReactiveSequence name="guarded_mission">
        <CheckTakeoverRequest/>
        <Sequence name="mission">

          <!-- 1. UNDOCKING -->
          <PublishState state="1"/>
          <NavigateToWaypoint name="exit_dock"
                              x="6.50" y="-20.67" z="2.28"
                              velocity="0.15" fixed_heading="true" heading="-1.5708"/>

          <!-- 2. TRANSIT TO PIPELINE -->
          <PublishState state="2"/>
          <NavigateToWaypoint name="transit_to_pipeline"
                              x="1.0" y="-12.5" z="2.75"
                              velocity="0.4" fixed_heading="false"/>

          <!-- 3. PIPELINE INSPECTION: markers 05, 06, 04, 03, 02 along the pipe (aruco_01 is not visited) -->
          <PublishState state="3"/>
          <NavigateToWaypoint name="nav_aruco_05"
                              x="1.0" y="-12.5" z="2.75"
                              velocity="0.25" fixed_heading="false"/>

          <NavigateToWaypoint name="nav_aruco_06"
                              x="-2.0" y="-10.0" z="2.75"
                              velocity="0.25" fixed_heading="false"/>

          <NavigateToWaypoint name="nav_aruco_04"
                              x="1.0" y="-7.0" z="2.75"
                              velocity="0.25" fixed_heading="false"/>

          <NavigateToWaypoint name="nav_aruco_03"
                              x="2.0" y="-4.5" z="2.75"
                              velocity="0.25" fixed_heading="false"/>

          <NavigateToWaypoint name="nav_aruco_02"
                              x="3.0" y="-1.8" z="2.75"
                              velocity="0.25" fixed_heading="false"/>

          <!-- 4. HOMING: join the dock centre line (north 6.5), then straight to the dock approach -->
          <PublishState state="4"/>
          <NavigateToWaypoint name="homing_midpoint"
                              x="6.5" y="-10.0" z="2.28"
                              velocity="0.25" fixed_heading="false"/>

          <NavigateToWaypoint name="dock_approach"
                              x="6.50" y="-19.0" z="2.28"
                              velocity="0.2" fixed_heading="false"/>

          <StationKeeping name="approach_heading_hold"
                          x="6.50" y="-19.0" z="2.28"
                          heading="-1.5708" duration="30"
                          heading_tolerance_deg="5" max_duration="60"/>

          <!-- 5. DOCKING -->
          <PublishState state="5"/>
          <LaunchDockingProcedure name="trigger_docking"/>
          <WaitForDocking name="wait_for_docking" timeout="300"/>

        </Sequence>
      </ReactiveSequence>

      <!-- ── TAKEOVER HANDLER (runs when CheckTakeoverRequest fails) ────── -->
      <Sequence name="takeover_handler">

        <!-- Hold position actively while the operator decides -->
        <HoldPosition/>
        <PublishState state="6"/>

        <Fallback name="human_decision_branch">

          <!-- Accepted: hand control to joystick, wait for handback -->
          <Sequence name="joystick_takeover">
            <WaitForHumanDecision/>
            <EnableJoystick/>
            <WaitForHandback/>
          </Sequence>

          <!-- Rejected: emergency return to dock -->
          <Sequence name="emergency_return">
            <PublishState state="4"/>
            <NavigateToWaypoint name="emergency_midpoint"
                                x="2.0" y="-15.0" z="2.28"
                                velocity="0.4" fixed_heading="false"/>
            <NavigateToWaypoint name="emergency_dock_approach"
                                x="6.50" y="-19.0" z="2.28"
                                velocity="0.2" fixed_heading="false"/>
            <!-- Face the docking station (markers in view) before docking, as in the normal mission -->
            <StationKeeping name="emergency_heading_hold"
                            x="6.50" y="-19.0" z="2.28"
                            heading="-1.5708" duration="30"
                            heading_tolerance_deg="5" max_duration="60"/>
            <PublishState state="5"/>
            <LaunchDockingProcedure name="emergency_docking"/>
            <WaitForDocking name="wait_emergency_docking" timeout="300"/>
          </Sequence>

        </Fallback>
      </Sequence>

    </Fallback>
  </BehaviorTree>
</root>
