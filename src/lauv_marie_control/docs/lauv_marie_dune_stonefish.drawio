<mxfile host="app.diagrams.net" agent="lauv_marie_control" version="24.7.17"><diagram id="page1" name="1 How it connects"><mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="LAUV Marie in Stonefish, flown by DUNE: how the pieces connect" style="text;html=1;whiteSpace=wrap;fontSize=26;fontColor=#1a1a1a;align=left;verticalAlign=top;spacing=2;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1760" height="36" as="geometry"/></mxCell><mxCell id="c4" value="The same onboard software (DUNE) and console (Neptus) as on the real vehicle. Only the water and Marie's body are simulated, by Stonefish." style="text;html=1;whiteSpace=wrap;fontSize=15;fontColor=#444444;align=left;verticalAlign=top;spacing=2;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="20" y="52" width="1760" height="26" as="geometry"/></mxCell><mxCell id="c5" value="1 · Operator" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;opacity=60;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=17;fontStyle=1;fontColor=#1f4e79;" vertex="1" parent="1"><mxGeometry x="20" y="95" width="300" height="690" as="geometry"/></mxCell><mxCell id="c6" value="Neptus, as with the real vehicle" style="text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#1f4e79;align=left;verticalAlign=top;spacing=2;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="32" y="129" width="276" height="40" as="geometry"/></mxCell><mxCell id="c7" value="2 · DUNE: Marie's onboard software" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;opacity=60;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=17;fontStyle=1;fontColor=#8a5300;" vertex="1" parent="1"><mxGeometry x="430" y="95" width="540" height="690" as="geometry"/></mxCell><mxCell id="c8" value="unchanged build (2025.04), running on the laptop;&lt;br&gt;its own vehicle physics are switched off" style="text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#8a5300;align=left;verticalAlign=top;spacing=2;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="442" y="129" width="516" height="40" as="geometry"/></mxCell><mxCell id="c9" value="3 · dune_bridge" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;opacity=60;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=17;fontStyle=1;fontColor=#5b3d6e;" vertex="1" parent="1"><mxGeometry x="1080" y="95" width="260" height="690" as="geometry"/></mxCell><mxCell id="c10" value="translator, ROS 2 node&lt;br&gt;(package lauv_marie_control)" style="text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#5b3d6e;align=left;verticalAlign=top;spacing=2;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="1092" y="129" width="236" height="40" as="geometry"/></mxCell><mxCell id="c11" value="4 · Stonefish" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;opacity=60;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=17;fontStyle=1;fontColor=#2e5c27;" vertex="1" parent="1"><mxGeometry x="1450" y="95" width="330" height="690" as="geometry"/></mxCell><mxCell id="c12" value="the water and Marie's body:&lt;br&gt;physics simulator with ROS 2" style="text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#2e5c27;align=left;verticalAlign=top;spacing=2;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="1462" y="129" width="306" height="40" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Neptus console&lt;/b&gt;&lt;br&gt;plans with the usual manoeuvres:&lt;br&gt;Goto, PopUp, YoYo, Elevator,&lt;br&gt;Loiter, Rows, Station keeping&lt;br&gt;&lt;br&gt;start, stop, abort&lt;br&gt;map: Marie where DUNE&lt;br&gt;thinks she is" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="35" y="175" width="270" height="225" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;or from a terminal&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;ros2 run lauv_marie_control&lt;br&gt;&amp;nbsp;dune_plan goto 100 50 \&lt;br&gt;&amp;nbsp;--depth 5 --popup&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="35" y="430" width="270" height="120" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Plan engine + manoeuvres&lt;/b&gt;&lt;br&gt;runs the plan step by step:&lt;br&gt;Goto, PopUp, YoYo, Elevator, …" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="445" y="175" width="290" height="100" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Guidance (path control)&lt;/b&gt;&lt;br&gt;desired heading, depth, speed" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="445" y="305" width="290" height="85" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Controllers (PID)&lt;/b&gt;&lt;br&gt;heading, depth / pitch, roll, speed&lt;br&gt;with Marie's depth and roll gains" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="445" y="420" width="290" height="95" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Fin allocator + motor model&lt;/b&gt;&lt;br&gt;4 fin angles: servos 0–3, ±25°&lt;br&gt;throttle → motor model → rpm" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="445" y="545" width="290" height="105" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Supervisors&lt;/b&gt;&lt;br&gt;operational limits, abort,&lt;br&gt;recovery if stuck" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="755" y="175" width="200" height="100" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Navigation filter&lt;/b&gt;&lt;br&gt;→ EstimatedState:&lt;br&gt;where DUNE thinks&lt;br&gt;Marie is" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="755" y="305" width="200" height="105" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Simulated sensors&lt;/b&gt;&lt;br&gt;DVL, compass (AHRS),&lt;br&gt;depth, GPS at surface,&lt;br&gt;from the motion it receives" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="755" y="440" width="200" height="115" as="geometry"/></mxCell><mxCell id="c22" value="Built-in vehicle physics&lt;br&gt;(VSIM): &lt;b&gt;switched off&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=13;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;fontColor=#1a1a1a;dashed=1;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="755" y="580" width="200" height="70" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Logger&lt;/b&gt; → Data.lsf.gz, one folder per plan:&lt;br&gt;every DUNE message, and Stonefish's true state" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="445" y="690" width="510" height="75" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Motion → DUNE&lt;/b&gt;&lt;br&gt;/lauv_marie/odom (Odometry)&lt;br&gt;→ IMC SimulatedState, 20 Hz&lt;br&gt;metres from the start point,&lt;br&gt;start point as lat/lon,&lt;br&gt;quaternion → roll, pitch, yaw" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1095" y="175" width="230" height="140" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Commands → Stonefish&lt;/b&gt;&lt;br&gt;IMC SetServoPosition (×4)&lt;br&gt;→ /lauv_marie/rudders&lt;br&gt;[top, bottom, port, stbd],&lt;br&gt;fin order and signs remapped&lt;br&gt;IMC Rpm&lt;br&gt;→ /lauv_marie/thrusters [rpm]" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1095" y="360" width="230" height="150" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Status → ROS 2&lt;/b&gt;&lt;br&gt;EstimatedState →&lt;br&gt;/lauv_marie/dune/estimated_state&lt;br&gt;PlanControlState →&lt;br&gt;/lauv_marie/dune/plan_state" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1095" y="545" width="230" height="135" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Odometry sensor&lt;/b&gt;&lt;br&gt;true position, attitude, speed&lt;br&gt;→ /lauv_marie/odom, 50 Hz" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1465" y="175" width="300" height="80" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Physics, 100 Hz&lt;/b&gt;&lt;br&gt;hull: buoyancy, drag, hull lift&lt;br&gt;propeller: thrust = 8.4·10⁻⁶ · rpm·|rpm| N&lt;br&gt;4 fins: lift and drag from&lt;br&gt;their angle and the water flow&lt;br&gt;water: still, flat seabed at 100 m&lt;br&gt;start: Trondheimsfjord" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1465" y="285" width="300" height="190" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;Marie's body&lt;/b&gt;&lt;br&gt;AUR-Lab 3D model, 2.05 m long&lt;br&gt;47.4 kg, slightly buoyant&lt;br&gt;propeller and 4 fins (±25°)&lt;br&gt;tuned on her September 2026&lt;br&gt;field logs (turning, diving)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1465" y="505" width="300" height="140" as="geometry"/></mxCell><mxCell id="c30" value="plans, start,&lt;br&gt;stop, abort" style="html=1;rounded=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1f4e79;fontSize=12;labelBackgroundColor=#ffffff;fontColor=#1a1a1a;edgeStyle=none;exitX=1;exitY=0.13;exitDx=0;exitDy=0;entryX=0;entryY=0.2;entryDx=0;entryDy=0;" edge="1" parent="1" source="c13" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="plan progress,&lt;br&gt;position, errors" style="html=1;rounded=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#8a5300;fontSize=12;labelBackgroundColor=#ffffff;fontColor=#1a1a1a;edgeStyle=none;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.33;entryDx=0;entryDy=0;" edge="1" parent="1" source="c15" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="IMC over UDP&lt;br&gt;port 6002" style="text;html=1;whiteSpace=wrap;fontSize=12;fontColor=#555555;align=center;verticalAlign=top;spacing=2;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="326" y="305" width="100" height="40" as="geometry"/></mxCell><mxCell id="c33" value="plan request&lt;br&gt;(UDP 6971)" style="html=1;rounded=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#1f4e79;fontSize=12;labelBackgroundColor=#ffffff;fontColor=#1a1a1a;edgeStyle=none;exitX=1;exitY=0.45;exitDx=0;exitDy=0;entryX=0;entryY=0.537;entryDx=0;entryDy=0;" edge="1" parent="1" source="c14" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c34" value="" style="html=1;rounded=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;fontSize=12;labelBackgroundColor=#ffffff;fontColor=#1a1a1a;edgeStyle=none;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c35" value="" style="html=1;rounded=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;fontSize=12;labelBackgroundColor=#ffffff;fontColor=#1a1a1a;edgeStyle=none;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c36" value="" style="html=1;rounded=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;fontSize=12;labelBackgroundColor=#ffffff;fontColor=#1a1a1a;edgeStyle=none;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c37" value="" style="html=1;rounded=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;fontSize=12;labelBackgroundColor=#ffffff;fontColor=#1a1a1a;edgeStyle=none;" edge="1" parent="1" source="c21" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c38" value="" style="html=1;rounded=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;fontSize=12;labelBackgroundColor=#ffffff;fontColor=#1a1a1a;edgeStyle=none;exitX=0;exitY=0.43;exitDx=0;exitDy=0;entryX=1;entryY=0.53;entryDx=0;entryDy=0;" edge="1" parent="1" source="c20" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c39" value="" style="html=1;rounded=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;fontSize=12;labelBackgroundColor=#ffffff;fontColor=#1a1a1a;edgeStyle=none;dashed=1;dashPattern=6 4;exitX=0;exitY=0.45;exitDx=0;exitDy=0;entryX=1;entryY=0.45;entryDx=0;entryDy=0;" edge="1" parent="1" source="c19" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c40" value="SimulatedState&lt;br&gt;(UDP 6971)" style="html=1;rounded=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#5b3d6e;fontSize=12;labelBackgroundColor=#ffffff;fontColor=#1a1a1a;edgeStyle=none;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c24" target="c21"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1025" y="245"/><mxPoint x="1025" y="497"/></Array></mxGeometry></mxCell><mxCell id="c41" value="4 fin angles + rpm  (UDP 6970)" style="html=1;rounded=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#8a5300;fontSize=12;labelBackgroundColor=#ffffff;fontColor=#1a1a1a;edgeStyle=none;exitX=1;exitY=0.52;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c18" target="c25"><mxGeometry x="-0.45" relative="1" as="geometry"><Array as="points"><mxPoint x="745" y="600"/><mxPoint x="745" y="668"/><mxPoint x="1045" y="668"/><mxPoint x="1045" y="435"/></Array></mxGeometry></mxCell><mxCell id="c42" value="/lauv_marie/&lt;br&gt;odom" style="html=1;rounded=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#2e5c27;fontSize=12;labelBackgroundColor=#ffffff;fontColor=#1a1a1a;edgeStyle=none;exitX=0;exitY=0.44;exitDx=0;exitDy=0;entryX=1;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="c27" target="c24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c43" value="/lauv_marie/&lt;br&gt;rudders&lt;br&gt;thrusters" style="html=1;rounded=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#5b3d6e;fontSize=12;labelBackgroundColor=#ffffff;fontColor=#1a1a1a;edgeStyle=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.79;entryDx=0;entryDy=0;" edge="1" parent="1" source="c25" target="c28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c44" value="" style="html=1;rounded=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;fontSize=12;labelBackgroundColor=#ffffff;fontColor=#1a1a1a;edgeStyle=none;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c28" target="c27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c45" value="" style="html=1;rounded=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;fontSize=12;labelBackgroundColor=#ffffff;fontColor=#1a1a1a;edgeStyle=none;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c29" target="c28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c46" value="What you see" style="text;html=1;whiteSpace=wrap;fontSize=20;fontColor=#1a1a1a;align=left;verticalAlign=top;spacing=2;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="800" width="900" height="30" as="geometry"/></mxCell><mxCell id="c47" value="&lt;b&gt;Neptus map and console&lt;/b&gt;&lt;br&gt;Marie where DUNE &lt;i&gt;thinks&lt;/i&gt; she is (its navigation estimate),&lt;br&gt;the plan, its progress and any errors, as for the real vehicle" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="20" y="838" width="560" height="95" as="geometry"/></mxCell><mxCell id="c48" value="&lt;b&gt;Stonefish 3D window&lt;/b&gt;&lt;br&gt;where she &lt;i&gt;really&lt;/i&gt; is: the true motion from the physics&lt;br&gt;(set Trackball center → LauvMarie to follow her)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="600" y="838" width="560" height="95" as="geometry"/></mxCell><mxCell id="c49" value="&lt;b&gt;Logs&lt;/b&gt;  ~/dune-simulator/dune-marie/log/…/Data.lsf.gz&lt;br&gt;replay and plots in Neptus MRA, or to CSV with&lt;br&gt;tools/extract_field_manoeuvres.py, the same as Marie's field logs" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1180" y="838" width="600" height="95" as="geometry"/></mxCell><mxCell id="c50" value="Checked 17 November 2026: plans made in Neptus (Goto, PopUp, Elevator 0 → 25 m) were flown by DUNE in Stonefish; DUNE's position estimate stayed within 0.2 m of Stonefish's true position." style="text;html=1;whiteSpace=wrap;fontSize=14;fontColor=#444444;align=left;verticalAlign=top;spacing=2;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="20" y="950" width="1760" height="50" as="geometry"/></mxCell><mxCell id="c51" value="Arrows: data flow (dashed: supervision). Colours: blue operator · orange DUNE · purple bridge · green Stonefish · yellow logs." style="text;html=1;whiteSpace=wrap;fontSize=12;fontColor=#777777;align=left;verticalAlign=top;spacing=2;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="20" y="1000" width="1760" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="page2" name="2 One control cycle"><mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="One control cycle: what happens 20 times a second" style="text;html=1;whiteSpace=wrap;fontSize=26;fontColor=#1a1a1a;align=left;verticalAlign=top;spacing=2;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="12" width="1760" height="36" as="geometry"/></mxCell><mxCell id="c4" value="Stonefish computes the true motion; DUNE senses it, decides and commands the fins and propeller; the bridge translates in both directions." style="text;html=1;whiteSpace=wrap;fontSize=15;fontColor=#444444;align=left;verticalAlign=top;spacing=2;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="20" y="52" width="1760" height="26" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;1 · Stonefish moves Marie&lt;/b&gt;&lt;br&gt;forces from propeller, fins,&lt;br&gt;buoyancy and drag → new&lt;br&gt;position and attitude" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="445" y="136" width="230" height="108" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;2 · Odometry&lt;/b&gt;&lt;br&gt;/lauv_marie/odom: NED position,&lt;br&gt;attitude, body velocities" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="742" y="241" width="230" height="108" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;3 · Bridge → DUNE&lt;/b&gt;&lt;br&gt;IMC SimulatedState: start&lt;br&gt;point (lat/lon) + metres,&lt;br&gt;roll, pitch, yaw" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="865" y="496" width="230" height="108" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;4 · DUNE senses&lt;/b&gt;&lt;br&gt;simulated DVL, AHRS, depth,&lt;br&gt;GPS → navigation filter →&lt;br&gt;EstimatedState" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="742" y="751" width="230" height="108" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;5 · DUNE decides&lt;/b&gt;&lt;br&gt;active manoeuvre + guidance:&lt;br&gt;desired heading, depth, speed" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="445" y="856" width="230" height="108" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;6 · DUNE commands&lt;/b&gt;&lt;br&gt;controllers + allocator:&lt;br&gt;4 fin angles; throttle →&lt;br&gt;motor model → rpm" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="148" y="751" width="230" height="108" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;7 · Bridge → Stonefish&lt;/b&gt;&lt;br&gt;fins → /lauv_marie/rudders&lt;br&gt;rpm → /lauv_marie/thrusters" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="25" y="496" width="230" height="108" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;8 · Fins and propeller act&lt;/b&gt;&lt;br&gt;new fin angles and propeller&lt;br&gt;speed in the physics → 1" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="148" y="241" width="230" height="108" as="geometry"/></mxCell><mxCell id="c13" value="" style="html=1;rounded=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;fontColor=#1a1a1a;edgeStyle=none;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="" style="html=1;rounded=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;fontColor=#1a1a1a;edgeStyle=none;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="" style="html=1;rounded=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;fontColor=#1a1a1a;edgeStyle=none;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="" style="html=1;rounded=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;fontColor=#1a1a1a;edgeStyle=none;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="" style="html=1;rounded=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;fontColor=#1a1a1a;edgeStyle=none;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="" style="html=1;rounded=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;fontColor=#1a1a1a;edgeStyle=none;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="" style="html=1;rounded=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;fontColor=#1a1a1a;edgeStyle=none;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="" style="html=1;rounded=1;endArrow=block;endFill=1;strokeWidth=3;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;fontColor=#1a1a1a;edgeStyle=none;" edge="1" parent="1" source="c12" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="&lt;b&gt;every 1/20 s&lt;/b&gt;&lt;br&gt;&lt;br&gt;Stonefish physics: 100 Hz&lt;br&gt;odometry: 50 Hz&lt;br&gt;state to DUNE: 20 Hz" style="text;html=1;whiteSpace=wrap;fontSize=15;fontColor=#1a1a1a;align=center;verticalAlign=middle;spacing=2;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="410" y="480" width="300" height="140" as="geometry"/></mxCell><mxCell id="c22" value="Message translation in dune_bridge" style="text;html=1;whiteSpace=wrap;fontSize=16;fontColor=#1a1a1a;align=left;verticalAlign=top;spacing=2;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1130" y="120" width="650" height="26" as="geometry"/></mxCell><mxCell id="c23" value="&lt;table style=&quot;border-collapse:collapse;width:625px;font-size:12px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #bbbbbb;padding:3px 6px;background:#eeeeee;text-align:left&quot;&gt;Stonefish side (ROS 2)&lt;/th&gt;&lt;th style=&quot;border:1px solid #bbbbbb;padding:3px 6px;background:#eeeeee;text-align:left&quot;&gt;&lt;/th&gt;&lt;th style=&quot;border:1px solid #bbbbbb;padding:3px 6px;background:#eeeeee;text-align:left&quot;&gt;DUNE side (IMC)&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbbbbb;padding:3px 6px&quot;&gt;/lauv_marie/odom (Odometry, 50 Hz)&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbbbbb;padding:3px 6px&quot;&gt;→&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbbbbb;padding:3px 6px&quot;&gt;SimulatedState, 20 Hz&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbbbbb;padding:3px 6px&quot;&gt;/lauv_marie/rudders [top, bottom, port, stbd]&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbbbbb;padding:3px 6px&quot;&gt;←&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbbbbb;padding:3px 6px&quot;&gt;SetServoPosition, servos 0–3&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbbbbb;padding:3px 6px&quot;&gt;/lauv_marie/thrusters [rpm]&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbbbbb;padding:3px 6px&quot;&gt;←&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbbbbb;padding:3px 6px&quot;&gt;Rpm (DUNE's motor model)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbbbbb;padding:3px 6px&quot;&gt;/lauv_marie/dune/estimated_state&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbbbbb;padding:3px 6px&quot;&gt;←&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbbbbb;padding:3px 6px&quot;&gt;EstimatedState&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbbbbb;padding:3px 6px&quot;&gt;/lauv_marie/dune/plan_state&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbbbbb;padding:3px 6px&quot;&gt;←&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbbbbb;padding:3px 6px&quot;&gt;PlanControlState&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b3b3b3;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=2;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1130" y="148" width="650" height="150" as="geometry"/></mxCell><mxCell id="c24" value="Fins: DUNE servo → Stonefish fin" style="text;html=1;whiteSpace=wrap;fontSize=16;fontColor=#1a1a1a;align=left;verticalAlign=top;spacing=2;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1130" y="318" width="650" height="26" as="geometry"/></mxCell><mxCell id="c25" value="&lt;table style=&quot;border-collapse:collapse;width:625px;font-size:12px&quot;&gt;&lt;tr&gt;&lt;th style=&quot;border:1px solid #bbbbbb;padding:3px 6px;background:#eeeeee;text-align:left&quot;&gt;DUNE servo&lt;/th&gt;&lt;th style=&quot;border:1px solid #bbbbbb;padding:3px 6px;background:#eeeeee;text-align:left&quot;&gt;fin&lt;/th&gt;&lt;th style=&quot;border:1px solid #bbbbbb;padding:3px 6px;background:#eeeeee;text-align:left&quot;&gt;Stonefish slot&lt;/th&gt;&lt;th style=&quot;border:1px solid #bbbbbb;padding:3px 6px;background:#eeeeee;text-align:left&quot;&gt;sign&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbbbbb;padding:3px 6px&quot;&gt;0&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbbbbb;padding:3px 6px&quot;&gt;lower rudder&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbbbbb;padding:3px 6px&quot;&gt;bottom&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbbbbb;padding:3px 6px&quot;&gt;reversed&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbbbbb;padding:3px 6px&quot;&gt;1&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbbbbb;padding:3px 6px&quot;&gt;port elevator&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbbbbb;padding:3px 6px&quot;&gt;port&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbbbbb;padding:3px 6px&quot;&gt;same&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbbbbb;padding:3px 6px&quot;&gt;2&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbbbbb;padding:3px 6px&quot;&gt;starboard elevator&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbbbbb;padding:3px 6px&quot;&gt;starboard&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbbbbb;padding:3px 6px&quot;&gt;same&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #bbbbbb;padding:3px 6px&quot;&gt;3&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbbbbb;padding:3px 6px&quot;&gt;upper rudder&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbbbbb;padding:3px 6px&quot;&gt;top&lt;/td&gt;&lt;td style=&quot;border:1px solid #bbbbbb;padding:3px 6px&quot;&gt;reversed&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br&gt;DUNE: positive rudder turns to port; Stonefish: to starboard.&lt;br&gt;Elevators: positive is nose down in both. Opposite angles within a pair roll the vehicle." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b3b3b3;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=2;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1130" y="346" width="650" height="180" as="geometry"/></mxCell><mxCell id="c26" value="Network and names" style="text;html=1;whiteSpace=wrap;fontSize=16;fontColor=#1a1a1a;align=left;verticalAlign=top;spacing=2;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1130" y="546" width="650" height="26" as="geometry"/></mxCell><mxCell id="c27" value="Neptus ↔ DUNE: IMC over UDP 6002; discovery multicast 30100–30104&lt;br&gt;DUNE → bridge: UDP 6970 · bridge → DUNE: UDP 6971&lt;br&gt;DUNE's name and IMC address: lauv-simulator-1, 0x00D1&lt;br&gt;start point 63.441° N, 10.351° E (Trondheimsfjord); NED frame, depth positive down" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b3b3b3;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1130" y="574" width="650" height="90" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Same as on the real Marie&lt;/b&gt;&lt;br&gt;• DUNE and its manoeuvres&lt;br&gt;• controllers, with Marie's gains&lt;br&gt;• IMC messages&lt;br&gt;• Neptus console and logs" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=2;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1130" y="690" width="315" height="135" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;Simulated, or not yet&lt;/b&gt;&lt;br&gt;• water and body: Stonefish,&lt;br&gt;&amp;nbsp;&amp;nbsp;tuned on her field logs&lt;br&gt;• sensors: DUNE's own models&lt;br&gt;• USBL: not yet&lt;br&gt;• coasts too far with the propeller off" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=13;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=2;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1465" y="690" width="315" height="135" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;Where things are&lt;/b&gt; (branch lauv-marie of blueyeSIM)&lt;br&gt;lauv_marie_control: dune_bridge.py, dune_plan.py, launch/lauv_marie_dune.launch.py,&lt;br&gt;&amp;nbsp;&amp;nbsp;dune/lauv-marie-stonefish.ini (DUNE's configuration)&lt;br&gt;stonefish_sim: drones/lauv_marie.scn (the vehicle), scenarios/lauv_marie.scn&lt;br&gt;DUNE: ~/dune-simulator/dune-marie (a copy of the AUR-Lab build, kept out of git)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b3b3b3;fontSize=12;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1130" y="845" width="650" height="118" as="geometry"/></mxCell><mxCell id="c31" value="Run it" style="text;html=1;whiteSpace=wrap;fontSize=16;fontColor=#1a1a1a;align=left;verticalAlign=top;spacing=2;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="995" width="1760" height="26" as="geometry"/></mxCell><mxCell id="c32" value="ros2 launch lauv_marie_control lauv_marie_dune.launch.py&amp;nbsp;&amp;nbsp;&amp;nbsp;# Stonefish + DUNE + bridge; in Neptus she is lauv-simulator-1&lt;br&gt;ros2 run lauv_marie_control dune_plan goto 100 50 --depth 5 --popup&amp;nbsp;&amp;nbsp;&amp;nbsp;# or make the plan in Neptus" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b3b3b3;fontSize=13;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;spacingTop=2;fontColor=#1a1a1a;fontFamily=Courier New;" vertex="1" parent="1"><mxGeometry x="20" y="1023" width="1760" height="62" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>