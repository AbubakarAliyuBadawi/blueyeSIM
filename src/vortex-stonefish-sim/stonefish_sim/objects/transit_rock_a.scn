<?xml version="1.0"?>
<scenario>

  <!-- First obstacle on the transit leg of the field-twin scenario (blueye_field_twin), the same rock as
       transit_rock.scn: about 1.5 m tall, 0.90 m across the track and 0.47 m along it. Placed by
       transit_rock_a_position / transit_rock_a_orientation in config/blueye_field_twin_config.yaml. -->
  <static name="TransitRockA" type="model">
    <physical>
      <!-- convex hull of rock.obj: cheap contacts, so the simulator keeps real time when the vehicle hits it -->
      <mesh filename="object_files/rock_collision.obj" scale="0.15"/>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
    </physical>
    <visual>
      <mesh filename="object_files/rock.obj" scale="0.15"/>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
    </visual>
    <material name="Rock"/>
    <look name="Gray"/>
    <world_transform xyz="$(param transit_rock_a_position)" rpy="$(param transit_rock_a_orientation)"/>
  </static>

</scenario>
