<?xml version="1.0"?>
<!-- LAUV Marie in open water: flat seabed (depth lauv_marie_seabed_depth of the scenario config, 30 m; 100 m
     when DUNE flies her, the depth of DUNE's own simulated sea), no current, no waves -->
<scenario>
  <environment>
    <ned latitude="63.446827" longitude="10.421906"/>
    <ocean>
        <water density="1025.0" jerlov="0.20"/>
        <waves height="0.0"/>
        <particles enabled="false"/>
        <current type="uniform">
            <velocity xyz="0.0 0.0 0.0"/>
        </current>
    </ocean>
    <atmosphere>
        <sun azimuth="-88.0" elevation="40.0"/>
    </atmosphere>
  </environment>

  <include file="$(find stonefish_sim)/metadata/materials.scn"/>
  <include file="$(find stonefish_sim)/metadata/looks.scn"/>
  <include file="$(find stonefish_sim)/drones/lauv_marie.scn"/>

  <static name="Seabed" type="plane">
    <material name="Rock"/>
    <look name="Brown"/>
    <world_transform xyz="0.0 0.0 $(param lauv_marie_seabed_depth)" rpy="0.0 0.0 0.0"/>
  </static>
</scenario>
