<?xml version="1.0"?>
<package format="3">
  <name>bn_state_viewer</name>
  <version>0.1.0</version>
  <description>Live view of every node and discrete state of the takeover Bayesian network.</description>
  <maintainer email="abubakaraliyubadawi@gmail.com">Badawi</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <exec_depend>blueye_takeover_bn</exec_depend>
  <exec_depend>python3-tk</exec_depend>

  <buildtool_depend>ament_python</buildtool_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
